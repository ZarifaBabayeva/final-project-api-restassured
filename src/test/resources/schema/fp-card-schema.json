{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Virtual card (GRAD-201)",
  "type": "object",
  "required": [
    "id",
    "accountId",
    "maskedPan",
    "expiry",
    "currency",
    "status",
    "availableBalance",
    "limits",
    "label",
    "blockReason",
    "blockedAt",
    "createdAt",
    "spentToday"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^vcd_[a-z0-9]{8}$"
    },
    "accountId": {
      "type": "string"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "maskedPan": {
      "type": "string",
      "pattern": "^4169 73[*]{2} [*]{4} [0-9]{4}$"
    },
    "expiry": {
      "type": "string",
      "pattern": "^[0-9]{2}/[0-9]{2}$"
    },
    "currency": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "FROZEN",
        "BLOCKED"
      ]
    },
    "availableBalance": {
      "type": "number"
    },
    "limits": {
      "type": "object",
      "required": [
        "dailyOnline",
        "perTransaction"
      ],
      "properties": {
        "dailyOnline": {
          "type": "number"
        },
        "perTransaction": {
          "type": "number"
        }
      }
    },
    "blockReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "spentToday": {
      "type": "number"
    }
  }
}