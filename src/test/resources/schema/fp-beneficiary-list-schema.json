{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Beneficiary list (GRAD-102)",
  "type": "object",
  "required": [
    "total",
    "items"
  ],
  "properties": {
    "total": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fullName",
          "iban",
          "ibanMasked",
          "currency",
          "nickname",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ben_[a-z0-9]{8}$"
          },
          "fullName": {
            "type": "string"
          },
          "iban": {
            "type": "string",
            "pattern": "^AZ[0-9]{2}[A-Z]{4}[A-Z0-9]{20}$"
          },
          "ibanMasked": {
            "type": "string"
          },
          "currency": {
            "enum": [
              "AZN",
              "USD",
              "EUR"
            ]
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        }
      }
    }
  }
}